# Host ports the compose stack publishes. Copy this file to .env and edit it,
# or pass any of them inline. Only the host side moves -- inside the compose
# network Postgres, Prometheus and Grafana keep their standard ports.
#
# 5432 and 3000 in particular are already taken on most machines that have run
# another project or a Node dev server.
#
# The Makefile reads this file, and anything already in the environment beats
# it, so both of these work and the inline one wins:
#   POSTGRES_HOST_PORT=5433 make db
#   make db            # with POSTGRES_HOST_PORT=5433 in .env
#
# Invoking compose directly needs the path spelled out, because the compose
# file lives in deploy/ and compose looks for deploy/.env by default:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d

POSTGRES_HOST_PORT=5432
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
