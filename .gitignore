# Build output. Anchored with a leading slash: bare `modelforge` would also
# match the cmd/modelforge source directory and silently exclude it.
/bin/
/modelforge
/modelforgectl

# Test and coverage artifacts
coverage.out
coverage.html

# Local artifact store, created by the server at runtime
/var/
/data/

# Python virtualenv for the fixture generator
.venv/
__pycache__/

# macOS / iCloud
.DS_Store
* 2.*

# A real bearer token for local Prometheus, generated by `make up`. The server
# only ever stores digests; this is the one file holding a secret, so it must
# not be committed.
/deploy/prometheus-token
/deploy/dev-tokens.env
